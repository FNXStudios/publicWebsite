# Canonical site origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.fnxstudio.com

# Origin (optionally with a base path) that game launchPath values resolve against.
# This origin is the only first-party entry in CSP frame-src.
#   production: https://games.fnxstudio.com
#   staging:    https://games-staging.fnxstudio.com
#   local:      http://localhost:4000
NEXT_PUBLIC_GAME_BASE_URL=https://games.fnxstudio.com

# Server-only. Validated contact enquiries are POSTed here as JSON.
# Leave unset and the form reports that it could not send (never a fake success).
CONTACT_SUBMIT_ENDPOINT=
CONTACT_SUBMIT_TOKEN=

# Set to "true" only when every request is served over HTTPS.
ENABLE_HSTS=false
